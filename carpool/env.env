# ============================================================
#  Carpool — configuración
#  Copia este fichero a .env y ajusta lo marcado como OBLIGATORIO.
#  El .env nunca se sube a Git: contiene tus contraseñas.
# ============================================================

# --- Aplicación ---------------------------------------------
APP_NAME=Carpool
APP_SUBTITLE=Reparto de gastos del coche

# OBLIGATORIO. Firma las sesiones. Genérala con:
#   openssl rand -hex 32
SECRET_KEY=cambia-esta-clave

# Cookie segura. Déjalo en true si accedes por HTTPS (túnel de
# Cloudflare). Ponlo en false solo para pruebas por HTTP en local.
COOKIE_SECURE=true


# --- Administrador inicial ----------------------------------
# OBLIGATORIO. Solo se usan en el primer arranque, cuando la base
# de datos está vacía. Después, para cambiar la contraseña:
#   ./scripts/reset-password.sh tu@correo.com
ADMIN_ALIAS=admin
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-password


# --- Base de datos ------------------------------------------
# OBLIGATORIO. La contraseña debe ser IDÉNTICA en POSTGRES_PASSWORD
# y dentro de DATABASE_URL. Evita @ : / que rompen el formato URL.
POSTGRES_USER=carpool
POSTGRES_PASSWORD=cambia-esta-password-db
POSTGRES_DB=carpool
DATABASE_URL=postgresql+psycopg2://carpool:cambia-esta-password-db@db:5432/carpool


# --- Rutas por carretera (OSRM) -----------------------------
OSRM_URL=http://osrm:5000
OSRM_PROFILE=driving
# Nombre base del extracto de OpenStreetMap ya procesado en
# ./osrm-data. Lo ajusta solo scripts/install.sh.
OSM_BASE=cataluna-latest


# --- Buscador de direcciones --------------------------------
# photon permite buscar mientras se escribe; nominatim es la
# alternativa. Si uno falla, se prueba el otro automáticamente.
GEO_PROVIDER=photon
PHOTON_URL=https://photon.komoot.io
NOMINATIM_URL=https://nominatim.openstreetmap.org
# Códigos de país para limitar la búsqueda (solo con nominatim)
GEO_PAISES=es

# Centro del mapa al abrirlo. Por defecto, Tarragona.
MAPA_LAT=41.1189
MAPA_LON=1.2445
MAPA_ZOOM=11


# --- Avisos por Telegram (opcional) -------------------------
# Recibes un mensaje cada vez que alguien registra un viaje.
# 1. Habla con @BotFather en Telegram y crea un bot con /newbot
# 2. Escribe cualquier mensaje a tu bot
# 3. Saca tu chat_id con:
#    curl -s "https://api.telegram.org/bot<TU_TOKEN>/getUpdates" \
#      | grep -o '"chat":{"id":[0-9-]*'
# Déjalas vacías para desactivar los avisos.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=


# --- Publicación (opcional) ---------------------------------
# Solo si NO tienes ya un túnel de Cloudflare en otra máquina.
# Con token, arranca con: docker compose --profile tunnel up -d
# y apunta el public hostname a http://app:8000
# Sin token, la app escucha en el puerto 8080 de esta máquina:
# apunta ahí el túnel que ya tengas.
TUNNEL_TOKEN=


# --- Mantenimiento ------------------------------------------
# Meses que se conservan los viajes (0 = sin purga automática)
RETENCION_MESES=24
