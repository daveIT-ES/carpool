# --- Aplicación ---------------------------------------------------
APP_NAME=Carpool
APP_SUBTITLE=Reparto de gastos del coche

# Genera la clave con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave

# Administrador inicial (solo se usa en el primer arranque)
ADMIN_ALIAS=admin
ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-password

# Cookie segura. Déjalo en true: el túnel de Cloudflare sirve por HTTPS.
COOKIE_SECURE=true

# --- Base de datos -------------------------------------------------
POSTGRES_USER=carpool
POSTGRES_PASSWORD=cambia-esta-password-db
POSTGRES_DB=carpool
DATABASE_URL=postgresql+psycopg2://carpool:cambia-esta-password-db@db:5432/carpool

# --- Routing -------------------------------------------------------
OSRM_URL=http://osrm:5000
OSRM_PROFILE=driving
# Nombre base del extracto OSM ya procesado dentro de ./osrm-data
OSM_BASE=cataluna-latest

# --- Publicación (opcional) -----------------------------------------
# Token del túnel de Cloudflare si quieres levantarlo desde este compose
TUNNEL_TOKEN=


# --- BOT TELGRAM (opcional) -----------------------------------------

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
